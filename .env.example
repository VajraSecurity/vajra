# Settings for docker-compose.yml. Copy to .env and fill in, or run ./docker/init-env.sh
# to generate one with random secrets.

# Name or IP that browsers and agents use to reach this machine. Agents on other machines
# need a real address, not localhost. Changing it later means rebuilding (docker compose up -d --build).
PUBLIC_HOST=localhost

# Password of the 'vajra' database role (used for both databases).
DB_PASSWORD=change-me

# Passphrase protecting the certificate authority key that vajra-server creates.
SSL_PASSWORD=change-me

# Shared secret agents use to enroll. Put the same value in the agents' enrollment_secret file.
ENROLLMENT_SECRET=change-me

# Secrets that sign the web console's login tokens. Use long random strings.
ACCESS_JWT_SECRET=change-me
REFRESH_JWT_SECRET=change-me

# Key that encrypts stored scanner credentials. Use a long random string.
NESSUS_ENCRYPTION_KEY=change-me

# Optional: osquery version downloaded into linux_agent.zip when linux_agent/common/osqueryd is absent.
# OSQUERY_VERSION=5.12.1

# Linux agent: the Vajra extension (extension.ext) is not in this repository. Either copy your build to
# linux_agent/common/extension.ext, or give a download URL and its SHA-256 (both are needed) and the
# agent packaging downloads and checks it. Then run: docker compose up -d --force-recreate agents
# EXTENSION_URL=https://example.com/path/extension.ext
# EXTENSION_SHA256=

# Optional: published ports on this machine.
# WEB_PORT=8080         web console
# API_PORT=4000         backend API and agent WebSocket
# FLEET_PORT=1234       agent enrollment and telemetry (C++ server)
