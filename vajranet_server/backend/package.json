{
  "name": "backend",
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "db:setup": "ts-node src/orm/config/ormconfig-setup.ts",
    "db:setup:fleet": "ts-node src/orm/config/ormconfig-setup.ts --fleet",
    "test": "npm run test:selftest && npm run test:unit",
    "test:selftest": "npm run test:mtls && npm run test:mfa-guard && npm run test:cert-provisioning && npm run test:patch-bundle && npm run test:patch-bundle-build && npm run test:patch-packages && npm run test:guardrails && npm run test:rule-engine-tools && npm run test:rule-engine-client && npm run test:ssrf-validation && npm run test:asset-identity-normalize && npm run test:asset-identity-resolve && npm run test:asset-identity-openvas-feeder && npm run test:url-identity && npm run test:fim-all",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:ws-slot-pool": "ts-node src/test/websocket/nodeSlotPool.selftest.ts && VAJRA_FAKE_REDIS=1 ts-node src/test/websocket/nodeSlotPool.selftest.ts",
    "test:mtls": "ts-node src/test/utils/agentMtls.selftest.ts",
    "test:totp": "ts-node src/test/utils/totp.selftest.ts",
    "test:mfa-guard": "ts-node src/test/middleware/checkJwt.selftest.ts",
    "test:cert-provisioning": "ts-node src/test/utils/agentCertProvisioning.selftest.ts",
    "test:patch-bundle": "ts-node src/test/utils/patchBundle.selftest.ts",
    "test:patch-bundle-build": "ts-node src/test/utils/patchBundleBuild.selftest.ts",
    "test:patch-packages": "ts-node src/test/utils/patchPackageValidation.selftest.ts",
    "test:guardrails": "ts-node src/test/mcp/guardrails.selftest.ts",
    "test:rule-engine-tools": "ts-node src/test/mcp/ruleEngineTools.selftest.ts",
    "test:rule-engine-client": "ts-node src/test/services/ruleEngineClient.selftest.ts",
    "test:ssrf-validation": "ts-node src/test/services/domainReputation/validation.selftest.ts",
    "test:asset-identity-normalize": "ts-node src/test/utils/assetIdentityNormalize.selftest.ts",
    "test:asset-identity-resolve": "ts-node src/test/utils/assetIdentityResolve.selftest.ts",
    "test:asset-identity-openvas-feeder": "ts-node src/test/services/assetIdentity/openvasFeeder.selftest.ts",
    "test:url-identity": "ts-node src/test/utils/urlIdentity.selftest.ts",
    "test:fim": "ts-node src/test/utils/fimLogic.selftest.ts",
    "test:fim-catalog": "ts-node src/test/utils/fimCatalog.selftest.ts",
    "test:fim-db": "ts-node src/test/services/fimDb.selftest.ts",
    "test:fim-registry": "ts-node src/test/utils/fimRegistry.selftest.ts",
    "test:fim-registry-db": "ts-node src/test/services/fimRegistryDb.selftest.ts",
    "test:fim-round6": "ts-node src/test/services/fimRound6.selftest.ts",
    "test:fim-round5": "ts-node src/test/services/fimRound5.selftest.ts",
    "test:fim-alerts-guard": "ts-node src/test/services/fimAlertsGuard.selftest.ts",
    "test:fim-load": "ts-node src/test/services/fimRegistryLoad.selftest.ts",
    "test:fim-all": "npm run test:fim && npm run test:fim-catalog && npm run test:fim-registry && npm run test:fim-db && npm run test:fim-registry-db && npm run test:fim-alerts-guard && npm run test:fim-round5 && npm run test:fim-round6",
    "patch-bundle:sign": "ts-node src/scripts/sign-patch-bundle.ts",
    "import:maintained-apps": "ts-node src/scripts/import-maintained-apps-catalog.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@httptoolkit/httpolyglot": "^3.1.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.2",
    "chartjs-node-canvas": "^5.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "disposable-email-domains-js": "^1.18.0",
    "dotenv": "^16.1.4",
    "ejs": "^6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "node-sql-parser": "^5.4.0",
    "openai": "^6.37.0",
    "otplib": "^13.5.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.6.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.11.0",
    "svg-captcha": "^1.4.0",
    "typeorm": "^0.3.31",
    "typeorm-naming-strategies": "^4.1.0",
    "validator": "^13.15.35",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "diff": "5.2.2",
    "qs": "^6.15.2",
    "minimatch": "10.2.5",
    "glob": "13.0.6",
    "brace-expansion": "^5.0.9",
    "body-parser": "^2.3.0",
    "follow-redirects": "1.16.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "2.3.2"
  }
}
