# Primary Database Configuration (users, sessions, audit)
PG_HOST=localhost
PG_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=vajra_db

# Secondary (Fleet) Database Configuration (nodes, alerts, osquery data)
# This MUST point to the same fleet database used by osquery / the agent.
PG_HOST1=localhost
PG_PORT1=5432
POSTGRES_USER1=vajra
POSTGRES_PASSWORD1=your_secure_fleet_db_password
POSTGRES_DB1=fleet

# Server Configuration
PORT=4000
# Production: set to "production" — enables secure cookies and production-mode guards
NODE_ENV=production

# Logging (see backend/src/utils/logger.ts)
# Controls verbosity: trace, debug, info, warn, error, fatal.
# Default: "debug" outside production, "info" in production.
# Output is structured JSON to stdout in production (captured by whatever
# runs the process — systemd/docker/pm2); pretty-printed to stdout elsewhere.
# LOG_LEVEL=info

# SSL Certificates (required in production)
# When set, Node serves BOTH plain HTTP/WS and HTTPS/WSS on the same PORT —
# it auto-detects which one each incoming connection is using (see
# backend/src/index.ts), so Go agents never need their own local
# websocket_secure config kept in sync with this setting. Leave both unset
# (e.g. local dev with no TLS capability) to serve plain HTTP only, same as
# before.
# Point these to your Let's Encrypt cert paths, e.g.:
#   SSL_KEY_PATH=/etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem
#   SSL_CERT_PATH=/etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem

# JWT / CSRF Configuration
# IMPORTANT: Generate strong random secrets for both access and refresh tokens
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_FOR_ACCESS_TOKEN
REFRESH_JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_FOR_REFRESH_TOKEN
ACCESS_JWT_EXPIRATION=15m
REFRESH_JWT_EXPIRATION=7d
CSRF_TOKEN_STRATEGY=UUID
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-XSRF-TOKEN
ACCESS_TOKEN_MAX_AGE_MS=900000
REFRESH_TOKEN_MAX_AGE_MS=604800000

# Frontend/Backend URLs
# Production: must match the HTTPS domain nginx is serving.
# Controls CORS allowed origins — browser will be blocked if this doesn't match.
FRONTEND_URL=https://YOUR_DOMAIN
BACKEND_URL=https://YOUR_DOMAIN

# Security Limits
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_CAPTCHA_EXPIRY_MS=60000
MAX_USER_COUNT=50

# Redis Configuration (for distributed stores)
# If Redis is unavailable, system falls back to in-memory storage
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Assistant Configuration
# Provider + API key are no longer configured via env vars — set them from
# the UI instead: Super Administrator → AI Assistant → Settings (gear icon).
# The config is stored encrypted in the database (ai_provider_configs table).

# Network Security / On-Prem Settings
# NESSUS_ENCRYPTION_KEY is the shared secret-encryption key for all
# encrypted external-tool credentials (Nessus, OpenVAS, Burpsuite, and
# Domain Reputation's manual-server/VirusTotal/AbuseIPDB API keys) — see utils/encryption.ts.
ON_PREM=true
NESSUS_ENCRYPTION_KEY=your_nessus_encryption_key_here

# Burp Suite Enterprise URL validation (controllers/burpsuite/burpsuiteController.ts).
# By default the configured Burp URL must be https:// and must not resolve to a
# private/loopback address. Set this to true for an internal-only Burp instance —
# it permits http:// and private/reserved addresses (e.g. the UI's own suggested
# http://127.0.0.1:1337).
#
# Understand what it costs before enabling: Burp embeds the API key in the URL
# PATH rather than a header, so over http:// that key is sent in cleartext in the
# request line and recorded in any proxy/access log in between — a credential
# disclosure, not merely unencrypted traffic. It also disables the SSRF guard that
# stops this server being pointed at internal hosts. Enable only on a trusted
# network segment, and rotate the Burp API key if it has been sent over http://.
# BURPSUITE_ALLOW_INSECURE_URL=true

# Agent mTLS (optional hardening, off by default)
# off (default): no client-cert check. optional: verify a cert when presented,
# still admit agents without one (use to watch enrollment progress in logs).
# required: reject any agent without a valid, CN-matched client certificate.
AGENT_MTLS_MODE=off

# Shared secret proving a request came through your nginx: configure nginx to send it as the
# X-Vajra-Internal-Secret header on proxied /ws requests. Without it, nginx-forwarded
# X-SSL-Client-* headers are never trusted, which fails closed and locks out all
# nginx-proxied agents in AGENT_MTLS_MODE=required.
# AGENT_MTLS_INTERNAL_SECRET=

# Agent mTLS certificate provisioning. NOT osquery's own enrollment (that is the C++ server's
# enroll_secret / node_key flow). This only issues the client certificate the agent extension
# uses on its WebSocket connection to this backend. It needs an Agent CA in AGENT_CA_DIR
# (default: backend/keys): agent-ca.crt and agent-ca.key. Create one once, for example:
#   openssl ecparam -name prime256v1 -genkey -noout -out backend/keys/agent-ca.key
#   openssl req -x509 -new -key backend/keys/agent-ca.key -sha256 -days 3650 \
#     -subj "/CN=Vajra Agent CA" -out backend/keys/agent-ca.crt
#   chmod 600 backend/keys/agent-ca.key
# Keep agent-ca.key as protected as any other secret in this file. Without these files,
# certificate provisioning is simply unavailable.
# AGENT_CA_DIR=/absolute/path/to/backend/keys
AGENT_CERT_VALIDITY_DAYS=397
AGENT_CERT_PROVISIONING_TOKEN_EXPIRY_HOURS=1

# Grafana Database Access (generated by grafana/setup.sh if missing)
GRAFANA_DB_PASSWORD=your_grafana_password_here

# Patch Bundle signing/verification (offline manual-upload workflow — see
# scripts/sign-patch-bundle.ts and utils/patchBundle.ts). Verify key is
# required for POST /api/patch/bundles (manual upload) to work at all.
# PATCH_BUNDLE_VERIFY_KEY_PATH=/absolute/path/to/backend/keys/patch_bundle_verify.pem

# Patch Bundle server-side build+sign pipeline (POST /api/patch/bundles/build
# — see controllers/nodes/patch_bundles_build.ts's header comment for the
# accepted-risk note: this signs with a key resident on THIS server, not an
# offline-only machine, per explicit product decision). All four required
# for the /build endpoint; the manual-upload endpoint above does not need any
# of them.
# PATCH_BUNDLE_STAGING_DIR=/absolute/path/to/a/directory/an/operator/drops/raw/deb/rpm/files/into
# PATCH_ARCHIVE_DIR=/absolute/path/to/a/directory/for/server-generated/tar.gz/output/only
# PATCH_ARCHIVE_BASE_URL=https://your-fleet-domain.example/  # used to build archive_url; or pass archive_base_url per-request instead
# PATCH_BUNDLE_SIGN_KEY_PATH=/absolute/path/to/backend/keys/patch_bundle_sign.key  # must be chmod 600 (owner-only) or the endpoint refuses to use it

# Rule Engine proxy (routes/api/rule-engine.ts, services/ruleEngineClient.ts).
# Base URL of the sibling vajra_server repo's internal rule engine console
# (rule_engine_ui — FastAPI, deliberately unauthenticated by design, internal
# network only). This app's own /api/rule-engine/* routes require a real
# authenticated session (and requireAdmin for writes) before ever forwarding
# a request here — never expose this URL directly to the browser.
# RULE_ENGINE_API_URL=http://127.0.0.1:8001

# get_rule_engine_reference AI tool (mcp/executor.ts). Optional: absolute path to
# RULE_AUTHORING_TEMPLATE.md (shipped in vajra_server/docs/), read live on every
# call so this tool can't drift from the maintained doc. Unset by default — the tool
# falls back to a minimal embedded summary until this is set for a deployment that has
# that file available.
# RULE_ENGINE_TEMPLATE_PATH=/absolute/path/to/vajra_server/docs/RULE_AUTHORING_TEMPLATE.md

# ---------------------------------------------------------------------------------------------
# File Integrity Monitoring: per-node Windows registry coverage (history hash chain)
# ---------------------------------------------------------------------------------------------
# HMAC key (>= 32 characters) of the registry history hash chain. REQUIRED while registry
# coverage is enabled: without it the registry feature is disabled (registry writes answer 503,
# a critical alert is raised, the UI shows a banner) - the rest of the backend keeps running.
# Generate one with:  openssl rand -hex 32   (do NOT reuse the placeholder text below; it is public).
# Set it BEFORE the first registry history row is written: unkeyed rows are accepted only ahead of
# the first keyed row. Keep a copy somewhere safe - losing it makes the chain unverifiable.
# FIM_HISTORY_HMAC_KEY=<output of openssl rand -hex 32>
# Id stored with every history row (default k1). Use a NEW id whenever you rotate the key.
# FIM_HISTORY_HMAC_KEY_ID=k1
# Older keys still needed to verify old rows, as a JSON object {"<id>": "<key>"}.
# Rotation: add the current id/key here, set a new FIM_HISTORY_HMAC_KEY + FIM_HISTORY_HMAC_KEY_ID,
# restart. Never remove a key while rows hashed with it exist (verification reports it).
# FIM_HISTORY_HMAC_PREVIOUS_KEYS={"k1":"the-previous-key"}
# Accept a weaker, UNKEYED chain explicitly (not recommended; the UI shows a red "history hash chain is NOT keyed"
# banner). Remove this once FIM_HISTORY_HMAC_KEY is set.
# FIM_HISTORY_ALLOW_UNKEYED=1
# Reconcile tuning: successful automatic publishes per 60 s sweep, and the sweep time box (ms).
# FIM_REG_AUTO_PUBLISH_PER_SWEEP=200
# FIM_REG_SWEEP_BUDGET_MS=40000
# Extra Windows service names of the endpoint agent(s), comma-separated, added to the built-in
# 'osqueryd' for the protected self-protection catalog entries (default: none extra).
# FIM_REG_AGENT_SERVICES=plgx_agent
#
# Test-only variables (FIM selftests; never needed in production):
#   FIM_TEST_PG=host:port      throwaway Postgres for the DB selftests (each process creates and
#                              drops its own database unless FIM_TEST_DB names a prepared one)
#   FIM_TEST_DB / FIM_TEST_USER / FIM_TEST_ADMIN_DB (default postgres)
#   FIM_ALLOW_SKIP=1           accept skipped gated tests (osqueryd / Postgres missing)
#   FIM_REG_LIVEDATA=<dir>     replay a full private Windows registry export (default: committed sample)
#   FIM_REQUIRE_LIVEDATA=1     make the replay mandatory
#   FIM_UPDATE_GOLDEN=1        regenerate the SQL golden file
#   FIM_LOAD_NODES / FIM_LOAD_INVALID / FIM_LOAD_PUBLISH / FIM_LOAD_MAX_STALL_MS   load test knobs

# FIM schema / least privilege: the backend needs no DDL privilege when the FIM schema is current.
# Apply vajra_server sql/migrations 0004-0008 (psql -1) and 0008a (without -1) as the schema owner;
# otherwise the registry is disabled with "FIM migration required" (see FIM_REGISTRY_DESIGN.md §8.2).
