# ──────────────────────────────────────────────────────────────────
# Frontend Environment Variables
# Copy to .env.local for local development, or .env.production for builds.
# ──────────────────────────────────────────────────────────────────

# Base URL of the backend (no trailing slash).
# Production: your HTTPS domain served by nginx.
# Development: leave as http://localhost:4000 (or omit to use this default).
VITE_API_BASE_URL=https://YOUR_DOMAIN

# WebSocket base URL (covers /ws/ui, /ws/ext, /ws/live).
# nginx proxies /ws → http://127.0.0.1:4000, so wss:// is correct here.
# If omitted, the frontend auto-derives this from VITE_API_BASE_URL:
#   https://YOUR_DOMAIN  →  wss://YOUR_DOMAIN/ws   (correct)
#   http://localhost:4000 →  ws://localhost:4000/ws (correct for dev)
VITE_WS_BASE_URL=wss://YOUR_DOMAIN/ws

# CSRF — must match backend CSRF_COOKIE_NAME and CSRF_HEADER_NAME in .env
VITE_CSRF_COOKIE_NAME=XSRF-TOKEN
VITE_CSRF_HEADER_NAME=X-XSRF-TOKEN

# Deployment mode: "on_prem" or "cloud"
# on_prem: enables Network Security (nmap, vulnerability scanner)
# cloud: disables Network Security features
VITE_DEPLOYMENT_MODE=on_prem

# Show the Rule Engine page/menu (hidden unless "true"; needs RULE_ENGINE_API_URL on the backend)
# VITE_RULE_ENGINE_ENABLED=true
