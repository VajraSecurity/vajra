server {
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    # Frontend static files (built with: cd frontend && npm run build)
    root /var/www/YOUR_DOMAIN/frontend/dist;


    # Response compression.
    # Ubuntu's stock /etc/nginx/nginx.conf sets `gzip on` but leaves
    # `gzip_types` commented out, so nginx's default applies and compresses
    # text/html only — the JS/CSS bundles and every /api JSON response would go
    # out uncompressed. Measured on a live deployment, the critical-path bundle
    # is 1,210 KB on the wire against 215 KB gzipped. Declaring the types here
    # keeps the setting with the app's own config rather than depending on a
    # hand-edit of the distro file.
    #
    # woff2 is deliberately absent: it is already Brotli-compressed internally,
    # so gzipping it burns CPU for essentially zero bytes.
    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_types        text/plain text/css text/xml text/javascript
                      application/javascript application/json application/xml
                      application/xml+rss image/svg+xml;

    # Static asset caching.
    # Vite emits content-hashed filenames, so a given /assets/ URL's bytes can
    # never change and are safe to cache permanently. Without this nginx sends
    # no Cache-Control at all and browsers fall back to heuristic freshness,
    # which after a deploy is near zero: 74% of asset requests measured as full
    # 200 re-downloads rather than 304s.
    location /assets/ {
        # The omission of "always" is deliberate. That flag would apply this
        # header to error responses too, so a missing chunk would be served as a
        # 404 carrying a one-year immutable directive and the browser would
        # cache that 404 for a year. Without it the header applies only to
        # 2xx/3xx.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html is the one unhashed entrypoint, so it must always be
    # revalidated or a deploy would never be picked up. `location /`'s
    # try_files internally redirects here, so SPA deep links are covered too.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri /index.html;
    }

    # Backend REST API
    location /api {
        proxy_pass         https://127.0.0.1:4000;
        proxy_ssl_verify   off;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
    }

    # Auth subrequest for Grafana
    location = /auth/grafana {
        internal;
        proxy_pass              https://127.0.0.1:4000/api/auth/validate;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        Cookie $http_cookie;
    }

    # Grafana reverse proxy
    location /grafana/ {
        auth_request     /auth/grafana;
        auth_request_set $vajra_user  $upstream_http_x_user_email;
        auth_request_set $vajra_name  $upstream_http_x_user_name;
        auth_request_set $vajra_role  $upstream_http_x_user_role;

        proxy_pass         http://127.0.0.1:3000/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";

        # Forward Vajra identity to Grafana
        proxy_set_header   X-WEBAUTH-USER      $vajra_user;
        proxy_set_header   X-WEBAUTH-USER-NAME $vajra_name;
        proxy_set_header   X-WEBAUTH-ROLE      $vajra_role;
    }

    # Health check
    location /health {
        proxy_pass         https://127.0.0.1:4000;
        proxy_ssl_verify   off;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
    }

    # WebSocket — covers /ws/ui, /ws/ext, /ws/live
    # Both read and send timeouts extended: connections are long-lived (heartbeat 25s).
    # Without these, the nginx default 60s timeout would kill idle WS connections.
    location /ws {
        proxy_pass         https://127.0.0.1:4000;
        proxy_ssl_verify   off;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    listen 443 ssl; # managed by Certbot
    # HTTP/2 lets the ~15 first-load assets multiplex over one connection
    # instead of queueing behind HTTP/1.1's 6-per-origin limit. The module is
    # compiled in (nginx -V shows --with-http_v2_module). nginx >= 1.25 wants
    # this standalone directive, not `listen ... http2`.
    http2 on;
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    # Redirect both bare domain and www to HTTPS.
    # The www redirect uses $host so the browser lands on https://www.YOUR_DOMAIN
    # (Certbot generates this pattern; both ifs are intentional).
    if ($host = www.YOUR_DOMAIN) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = YOUR_DOMAIN) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name YOUR_DOMAIN www.YOUR_DOMAIN;
    listen 80;
    return 404;
}
