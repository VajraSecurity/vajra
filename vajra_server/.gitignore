# Build output (CMakeCache.txt bakes in machine-specific absolute paths --
# committing these breaks `cmake -S . -B build` on any other checkout, CI
# included, with a fatal cache-mismatch error)
/build/
/engine_v2/build/
/cmake-build-*/
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.exe

# Vendored/fetched third-party build output and source (see
# scripts/bootstrap_deps_pqxx.sh) -- regenerated on demand, not committed.
/3rdparty/local/
3rdparty/libpqxx-*/
3rdparty/librdkafka-*/

# Local runtime config/secrets -- config.template.json is the tracked,
# secret-free template; config.json (and its vajra.sh-generated .backup)
# holds real credentials once patched.
/config.json
/config.json.backup
/enrollment_secret.txt

# TLS material generated by vajra.sh/scripts/gen-ssl.sh
/ssl/

# Editor / IDE
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Test/coverage artifacts
*.gcda
*.gcno
*.profraw

# Miscellaneous
graphify-out/
.claude
CLAUDE.md
